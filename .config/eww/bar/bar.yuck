(include "bar/widgets/systray.yuck")
(include "bar/widgets/audio.yuck")

(defwindow bar
  :monitor "0"
  :geometry (geometry
    :anchor "top center"
    :x "0"
    :y "0"
    :width "100%"
    :height "30"
  )
  :exclusive true ; wayland equivalent of reserve to auto reserve space
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (box
    :orientation "h"
    :halign "fill"
    :hexpand true
    
    (box
      :orientation "h"
      :class "left-piece"
      :halign "start"
      :space-evenly false
      :hexpand true
      (tray)
    )
    
    (box
      :orientation "h"
      :class "center-piece"
      :halign "center"
      :space-evenly false
      
      (eventbox
        :class "btn clock"
        :cursor "pointer"
        :width "130"
        :hexpand true
        :tooltip "toggle seconds"
        :onclick "eww update show-seconds=${!show-seconds}"
      "${show-seconds ? times : time}")
      
      (divider)
      
      (box
        :orientation "h"
        :halign "center"
        :style "padding: 0 10px;"
        
        (eventbox
          :class "btn moji"
          :cursor "pointer"
          :onclick "notify-send 'carpe diem'"
          :tooltip "carpe diem"
        "＾◉ ∀ ◉＾")
      )
      
      
      (divider)
      
      (eventbox
        :class "btn calendar"
        :cursor "pointer"
        :width "130"
        :hexpand true
      "${date}")
    )
    
    (box
      :orientation "h"
      :class "right-piece"
      :halign "end"
      :spacing "1"
      :space-evenly false
      :hexpand true
      
      (box
        :orientation "h"
        :halign "center"
        :style "padding: 0 10px;"
        
        (eventbox
          :tooltip "Network Status"
          :onclick "eww update show-bitrate=${!show-bitrate}"
          "${show-bitrate ? '${round(EWW_NET.enp34s0.NET_UP / 1000, 1) } kB/s ↑ ${round(EWW_NET.enp34s0.NET_DOWN / 1000, 1) } kB/s ↓' : network-status}"
        )
      )
      
      
      (divider)
      
      (box
        :orientation "h"
        :halign "center"
        :style "padding: 0 10px;"
        
        (eventbox
          :tooltip "RAM: ${round(EWW_RAM.used_mem / 1073741824, 1)} GB / ${round(EWW_RAM.total_mem / 1073741824, 1)} GB"
          "RAM: ${round(EWW_RAM.used_mem_perc,0)}%"
        )
      )
      
      (divider)
      
      (box
        :orientation "h"
        :halign "center"
        :style "padding: 0 10px;"
        (eventbox
          :tooltip "CPU: ${round(EWW_CPU.avg,1)}%"
          "CPU: ${round(EWW_CPU.avg,0)}%"
        )
      )
      
      (divider)
      
      (audio)
    )
  )
)

(defwidget divider []
  (label :class "divider" :text "|")
)

(defvar bar-visible true)
(defvar show-seconds false)

(defpoll time :interval "1s"
  :initial "--:-- ---"
  :run-while bar-visible
  `date +"%R %a"`
)

(defpoll times :interval "1s"
  :initial "--:-- ---"
  :run-while {bar-visible && show-seconds}
  `date +"%R:%S %a"`
)

(defpoll date :interval "1s"
  :initial "--- -- ----"
  :run-while bar-visible
  `date +"%b %d %Y"`
)

(defvar show-bitrate true)

(defpoll network-status :interval "1s"
  :initial "N/A"
  :run-while bar-visible
  `nmcli -t -f STATE,TYPE  device status | grep -E 'ethernet|wifi'`
)
