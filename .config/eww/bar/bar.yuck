(include "bar/widgets/systray.yuck")

(defwindow bar
  :monitor "0"
  :geometry (geometry
    :anchor "top center"
    :x "0"
    :y "0"
    :width "100%"
    :height "30"
  )
  :exclusive true ; wayland equivalent of reserve to auto reserve space
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (box
    :orientation "h"
    :halign "fill"
    :hexpand true
    
    (box
      :orientation "h"
      :class "left-piece"
      :halign "start"
      :space-evenly false
      :spacing "1"
      :hexpand true
      (tray)
    )
    
    (box
      :orientation "h"
      :class "center-piece"
      :halign "center"
      :space-evenly false
      :spacing "1"
      
      (eventbox
        :class "btn clock"
        :cursor "pointer"
        :width "140"
        :hexpand true
        :onclick "eww update show-seconds=${!show-seconds}"
      "${show-seconds ? times : time}")
      
      (eventbox
        :class "btn moji"
        :cursor "pointer"
        :width "100"
        :onclick "notify-send carpe diem"
        :tooltip "carpe diem"
      "＾◉ ∀ ◉＾")
      
      (eventbox
        :class "btn calendar"
        :cursor "pointer"
        :width "140"
        :hexpand true
      "${date}")
    )
    
    (box
      :orientation "h"
      :class "right-piece"
      :halign "end"
      :space-evenly false
      :spacing "1"
      
      (eventbox
        :class "btn"
        :cursor "pointer"
        :width "100"
        :onclick "notify-send carpe diem"
        :tooltip "carpe diem"
      "")
    )
  )
)

(defvar bar-visible true)
(defvar show-seconds false)

(defpoll time :interval "1s"
  :initial "--:-- ---"
  :run-while bar-visible
  `date +"%R %a"`
)

(defpoll times :interval "1s"
  :initial "--:-- ---"
  :run-while {show-seconds && bar-visible}
  `date +"%R:%S"`
)

(defpoll date :interval "1s"
  :initial "--- -- ----"
  :run-while bar-visible
  `date +"%b %d %Y"`
)