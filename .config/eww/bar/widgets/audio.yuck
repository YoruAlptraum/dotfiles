(deflisten audio-vol
  :initial "0"
  "bar/scripts/audio.sh"
)

(deflisten mic-vol
  :initial "0"
  "bar/scripts/mic.sh"
)

;    
; (defvar audio-icon "")
(defvar audio-icon "")
;  󰍭
(defvar mic-icon "")

(defwidget audio []
  (box
    :orientation "h"
    :halign "center"
    :style "padding: 0 10px;"
    :spacing "10"
    
    ; Audio
    (eventbox
      :space-evenly false
      :width "40"
      :orientation "h"
      :halign "center"
      :cursor "pointer"
      :tooltip "Volume: ${audio-vol}%"
      :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
      :onscroll "
      if [[ '{}' == 'up' ]];
      then wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ ;
      else wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01- ;
      fi
      "
      (box
        :orientation "h"
        :spacing "10"
        
        (label
          :halign "center"
          :text "${audio-icon}"
        )
        
        (circular-progress
          :size "5"
          :thickness "2"
          :value "${audio-vol}"
        )
      )
    )
    
    ; Microphone
    (eventbox
      :space-evenly false
      :width "40"
      :orientation "h"
      :halign "center"
      :cursor "pointer"
      :tooltip "Volume: ${mic-vol}%"
      :onclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
      :onscroll "
      if [[ '{}' == 'up' ]];
      then wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 0.01+ ;
      else wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 0.01- ;
      fi
      "
      
      (box
        :orientation "h"
        :spacing "10"
        
        (label
          :halign "center"
          :text "${mic-icon}"
        )
        
        (circular-progress
          :size "5"
          :thickness "2"
          :value "${mic-vol}"
        )
      )
    )
  )
)